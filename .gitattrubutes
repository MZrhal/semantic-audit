# Normalize text files to LF
* text=auto

# Source code and configuration
*.py text eol=lf
*.toml text eol=lf
*.ttl text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.pdf binary
*.zip binary